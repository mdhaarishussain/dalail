{
  "name": "@dalail/mobile",
  "version": "0.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@dalail/core": "workspace:*",
    "@op-engineering/op-sqlite": "^19.0.3",
    "expo": "~58.0.22",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.29",
    "expo-sharing": "~58.0.21",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "llama.rn": "0.13.0-rc.9",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-device-info": "^15.0.2",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/helpers"
    ],
    "testTimeout": 60000,
    "setupFilesAfterEnv": [
      "./jest.after-env.ts"
    ]
  },
  "op-sqlite": {
    "fts5": true,
    "sqliteVec": true
  }
}
