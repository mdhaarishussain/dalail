{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eval question file",
  "type": "object",
  "additionalProperties": false,
  "required": ["questions"],
  "properties": {
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["q"],
        "anyOf": [{ "required": ["expect"] }, { "required": ["expect_status"] }],
        "properties": {
          "q": {
            "type": "string",
            "minLength": 1,
            "description": "The question exactly as the person typed it."
          },
          "expect": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "expect_status": { "enum": ["match", "ambiguous", "no_match"] },
          "style": { "type": "string" },
          "added_by": {
            "type": "string",
            "description": "Real files: the human who wrote or collected it."
          },
          "added_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "origin": {
            "type": "string",
            "description": "e.g. 'owner', 'scholar', 'saved-question export'"
          }
        }
      }
    }
  }
}
